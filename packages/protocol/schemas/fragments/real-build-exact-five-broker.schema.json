{
  "title": "Real-build exact-five broker consumption contracts",
  "roots": ["RealBuildExactFiveBrokerChallengeV1", "RealBuildExactFiveBrokerConsumptionReceiptV1"],
  "definitions": {
    "RealBuildExactFiveChallengeNonce": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "not": { "pattern": "[\\r\\n\\u000B\\u000C\\u0085\\u2028\\u2029]" }
    },
    "RealBuildExactFiveDigest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "not": { "pattern": "[\\r\\n\\u000B\\u000C\\u0085\\u2028\\u2029]" }
    },
    "RealBuildExactFiveIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "not": { "pattern": "[\\r\\n\\u000B\\u000C\\u0085\\u2028\\u2029]" }
    },
    "RealBuildExactFiveStableLoopbackOrigin": {
      "type": "string",
      "minLength": 14,
      "maxLength": 64,
      "pattern": "^https?://(?:127\\.0\\.0\\.1|\\[::1\\]):(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
      "not": { "pattern": "[\\r\\n\\u000B\\u000C\\u0085\\u2028\\u2029]" }
    },
    "RealBuildExactFiveEd25519Signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "not": { "pattern": "[\\r\\n\\u000B\\u000C\\u0085\\u2028\\u2029]" }
    },
    "RealBuildExactFiveEd25519SealV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "keyEpoch", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/definitions/RealBuildExactFiveIdentifier" },
        "keyEpoch": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "signature": { "$ref": "#/definitions/RealBuildExactFiveEd25519Signature" }
      }
    },
    "RealBuildExactFiveBrokerChallengeV1": {
      "description": "Structural wire schema only. The exchange parser checks cross-record binding and temporal order relative to a caller-provided clock sample; only the bounded inspector supplies a held local clock, verifies the signature, and checks the exact live issued challenge. Neither schema nor exchange parsing grants authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "namespace",
        "purpose",
        "scope",
        "requestDigest",
        "reviewPresentationDigest",
        "trustBindingDigest",
        "challengeNonce",
        "issuedAtUnixMs"
      ],
      "properties": {
        "schemaVersion": { "const": "lego.real-build-exact-five-broker-challenge/1" },
        "namespace": { "enum": ["production", "test"] },
        "purpose": { "const": "admit-exact-five-official-frame-equivalence" },
        "scope": { "const": "exact-five-source-parity-calibration-panels-only" },
        "requestDigest": { "$ref": "#/definitions/RealBuildExactFiveDigest" },
        "reviewPresentationDigest": { "$ref": "#/definitions/RealBuildExactFiveDigest" },
        "trustBindingDigest": { "$ref": "#/definitions/RealBuildExactFiveDigest" },
        "challengeNonce": { "$ref": "#/definitions/RealBuildExactFiveChallengeNonce" },
        "issuedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "RealBuildExactFiveBrokerConsumptionReceiptV1": {
      "description": "Structural wire schema only. The exchange parser checks cross-record binding and temporal order relative to a caller-provided clock sample; only the bounded inspector supplies a held local clock, verifies the signature, and checks the exact live issued challenge. Neither schema nor exchange parsing grants authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "signatureDomain",
        "namespace",
        "purpose",
        "scope",
        "requestDigest",
        "challengeNonce",
        "audience",
        "stableOrigin",
        "pairedDeviceId",
        "brokerInstallId",
        "decision",
        "reviewPresentationDigest",
        "brokerReleaseId",
        "brokerEventId",
        "consumedAtUnixMs",
        "ledgerSequence",
        "previousLedgerRoot",
        "consumptionEventHash",
        "resultingLedgerRoot",
        "seal"
      ],
      "properties": {
        "schemaVersion": {
          "const": "lego.real-build-exact-five-broker-consumption-receipt/1"
        },
        "signatureDomain": {
          "const": "lego.real-build-exact-five-broker-consumption-receipt-signature/1"
        },
        "namespace": { "enum": ["production", "test"] },
        "purpose": { "const": "admit-exact-five-official-frame-equivalence" },
        "scope": { "const": "exact-five-source-parity-calibration-panels-only" },
        "requestDigest": { "$ref": "#/definitions/RealBuildExactFiveDigest" },
        "challengeNonce": { "$ref": "#/definitions/RealBuildExactFiveChallengeNonce" },
        "audience": { "$ref": "#/definitions/RealBuildExactFiveIdentifier" },
        "stableOrigin": { "$ref": "#/definitions/RealBuildExactFiveStableLoopbackOrigin" },
        "pairedDeviceId": { "$ref": "#/definitions/RealBuildExactFiveIdentifier" },
        "brokerInstallId": { "$ref": "#/definitions/RealBuildExactFiveIdentifier" },
        "decision": { "const": "approved" },
        "reviewPresentationDigest": { "$ref": "#/definitions/RealBuildExactFiveDigest" },
        "brokerReleaseId": { "$ref": "#/definitions/RealBuildExactFiveIdentifier" },
        "brokerEventId": { "$ref": "#/definitions/RealBuildExactFiveIdentifier" },
        "consumedAtUnixMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ledgerSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previousLedgerRoot": { "$ref": "#/definitions/RealBuildExactFiveDigest" },
        "consumptionEventHash": { "$ref": "#/definitions/RealBuildExactFiveDigest" },
        "resultingLedgerRoot": { "$ref": "#/definitions/RealBuildExactFiveDigest" },
        "seal": { "$ref": "#/definitions/RealBuildExactFiveEd25519SealV1" }
      }
    }
  }
}
