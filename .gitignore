# Dependencies
node_modules/
.pnpm-store/
.npm/
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/sdks/
!/.yarn/versions/
.pnp.*

# Build, test, and tool output
dist/
coverage/
.nyc_output/
.vite/
*.lcov
*.tsbuildinfo
.eslintcache
.stylelintcache

# Raw browser and reviewer evidence
test-results/
playwright-report/
blob-report/
.playwright-cli/
/tmp/review-runs/

# Product, broker, and recursive-loop artifacts.
# The whole of /var/ is ignored, not just runs/ and state/. The spec gives var/
# exactly those two children and calls both ignored, so nothing under it is ever
# a repository input — but naming only the two left the root itself offered to
# Git, and an analysis session filled it with 62 MB of booklet crops and scratch
# Python that a sweeping `git add` would have committed. Same accident the
# recipes/ line below exists to prevent, one directory up.
/var/
/output/

# Agent worktrees. Each is a whole checkout of this repository nested inside it,
# so a sweeping `git add` offers a duplicate of every tracked file to the commit
# — the same accident as /var/ above, one directory deeper and thousands of
# files wider. Only .git/info/exclude carried this, which is per-machine and
# does not survive a clone, so a rebuilt machine had the hole open again.
# worktrees/ alone, not .claude/: launch.json beside it is tracked.
/.claude/worktrees/

# Logs and process state
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.pid
*.pid.lock

# Local environment and secrets
.env
.env.*
!.env.example

# Local caches
.cache/
.parcel-cache/

# Python bytecode. Scripts are invoked with `python -B` so this should stay
# empty, but a single run that forgets the flag would otherwise offer ~300 KB
# of generated bytecode to the next `git add`.
__pycache__/
.pytest_cache/
*.py[cod]

# The sample instruction booklet: 70 MB of copyrighted LEGO artwork, kept
# locally and never committed. It was swept into a commit once by a sweeping
# `git add`, which is what this line exists to prevent.
recipes/

# Downloaded LDraw part files, re-fetched on demand by scripts/ldraw-part-facts.mjs.
scripts/ldraw-cache/

# Scratch space.
tmp/
